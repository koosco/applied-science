{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":[" "],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Applied Science","text":"<p>\uc218\ud559\uacfc \uacf5\ud559\uc758 \uc6d0\ub9ac\ub97c \uc77d\uace0, \uac04\ub2e8\ud55c Python \uc2dc\ubbac\ub808\uc774\uc158\uc73c\ub85c \ud655\uc778\ud558\ub294 \ud559\uc2b5 \ub178\ud2b8\uc785\ub2c8\ub2e4.</p>"},{"location":"#_1","title":"\ud559\uc2b5 \ubb38\uc11c","text":"<ul> <li>\ud3ec\ubb3c\uc120 \uc6b4\ub3d9: \uc6b4\ub3d9 \ubc29\uc815\uc2dd\uc744 \uc720\ub3c4\ud558\uace0 \ucd08\uae30 \uc18d\ub3c4\uc640 \ubc1c\uc0ac \uac01\ub3c4\uac00 \uada4\uc801\uc5d0 \ubbf8\uce58\ub294 \uc601\ud5a5\uc744 \uc0b4\ud3b4\ubd05\ub2c8\ub2e4.</li> <li>\uc2dc\ubbac\ub808\uc774\ud130 \ub3d9\uc791 \ud655\uc778: \uc2ac\ub77c\uc774\ub354\ub97c \uc870\uc791\ud558\uace0 \uada4\uc801\uacfc \uacc4\uc0b0\uac12\uc774 \ud568\uaed8 \ubc14\ub00c\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ul> <p>\ubb38\uc11c\ub294 Markdown\uc73c\ub85c \uc791\uc131\ud569\ub2c8\ub2e4. \uc2e4\ud589 \uac00\ub2a5\ud55c \uc2dc\ubbac\ub808\uc774\ud130\uac00 \ub3c4\uc6c0\uc774 \ub418\ub294 \uc8fc\uc81c\uc5d0\ub9cc Python \uc608\uc81c\ub97c \uc5f0\uacb0\ud569\ub2c8\ub2e4.</p>"},{"location":"test/","title":"\uc2dc\ubbac\ub808\uc774\ud130 \ub3d9\uc791 \ud655\uc778","text":"<p>\uc544\ub798 \uc2dc\ubbac\ub808\uc774\ud130\uc5d0\uc11c \ucd08\uae30 \uc18d\ub825\uacfc \ubc1c\uc0ac \uac01\ub3c4\ub97c \ubc14\uafb8\uba74 \uada4\uc801\uacfc \uacc4\uc0b0\uac12\uc774 \ud568\uaed8 \uac31\uc2e0\ub429\ub2c8\ub2e4. \ud3ec\ubb3c\uc120 \uc6b4\ub3d9 \ubb38\uc11c\uc5d0\uc11c \ubaa8\ub378\uc758 \uac00\uc815\uacfc \uc218\uc2dd\uc744 \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p> <p>\uc2dc\ubbac\ub808\uc774\ud130 \uc0c8 \ucc3d\uc5d0\uc11c \uc5f4\uae30</p>"},{"location":"test/#_2","title":"\ud655\uc778 \ubc29\ubc95","text":"<ol> <li>\uae30\ubcf8\uac12\uc778 \ucd08\uae30 \uc18d\ub825 20 m/s, \ubc1c\uc0ac \uac01\ub3c4 45\u00b0\uc5d0\uc11c \ub3c4\ub2ec \uac70\ub9ac \uc57d 40.77 m\ub97c \ud655\uc778\ud569\ub2c8\ub2e4.</li> <li>\ucd08\uae30 \uc18d\ub825\uc744 30 m/s\ub85c \ubc14\uafb8\uace0 \uada4\uc801\uc774 \ub2ec\ub77c\uc9c0\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4. \uac19\uc740 \uac01\ub3c4\uc5d0\uc11c \ub3c4\ub2ec \uac70\ub9ac\ub294 \uc57d 91.74 m\uc785\ub2c8\ub2e4.</li> <li>\uac01\ub3c4\ub97c \ubc14\uafb8\uace0 \ucd5c\uace0 \ub192\uc774\uc640 \ub3c4\ub2ec \uac70\ub9ac\uac00 \ub2e4\uc2dc \uacc4\uc0b0\ub418\ub294\uc9c0 \ud655\uc778\ud569\ub2c8\ub2e4.</li> </ol> <p>\uc774\uc0c1\uc801\uc778 \ubaa8\ub378\uc758 \uacb0\uacfc\uc774\uba70 \uacf5\uae30 \uc800\ud56d\uc740 \ud3ec\ud568\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.</p>"},{"location":"mechanics/projectile-motion/","title":"\ud3ec\ubb3c\uc120 \uc6b4\ub3d9","text":"<p>\ucd08\uae30 \uc18d\ub3c4\ub85c \ub358\uc9c4 \ubb3c\uccb4\uac00 \uc911\ub825\ub9cc \ubc1b\uc744 \ub54c\uc758 \uada4\uc801\uc744 \uc0b4\ud3b4\ubd05\ub2c8\ub2e4. \uc218\ud3c9 \ubc29\ud5a5\uc758 \uc6b4\ub3d9\uacfc \uc218\uc9c1 \ubc29\ud5a5\uc758 \uc6b4\ub3d9\uc744 \ub098\ub204\uc5b4 \uc0dd\uac01\ud558\uba74 \uc704\uce58\ub97c \uacc4\uc0b0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4.</p>"},{"location":"mechanics/projectile-motion/#_2","title":"\uac00\uc815\uacfc \ubcc0\uc218","text":"<ul> <li>\ubb3c\uccb4\ub97c \uc9c0\uba74\uc758 \uc6d0\uc810 \\((0, 0)\\)\uc5d0\uc11c \ubc1c\uc0ac\ud569\ub2c8\ub2e4.</li> <li>\uacf5\uae30 \uc800\ud56d\uc744 \ubb34\uc2dc\ud558\uace0 \uc911\ub825\uac00\uc18d\ub3c4 \\(g = 9.81\\,\\mathrm{m/s^2}\\)\ub97c \uc77c\uc815\ud558\uac8c \ub461\ub2c8\ub2e4.</li> <li>\\(v_0\\): \ucd08\uae30 \uc18d\ub825 \\(\\mathrm{m/s}\\)</li> <li>\\(\\theta\\): \uc218\ud3c9\uba74\uc744 \uae30\uc900\uc73c\ub85c \ud55c \ubc1c\uc0ac \uac01\ub3c4</li> <li>\\(t\\): \ubc1c\uc0ac \ud6c4 \uc2dc\uac04 \\(\\mathrm{s}\\)</li> </ul>"},{"location":"mechanics/projectile-motion/#_3","title":"\uc6b4\ub3d9 \ubc29\uc815\uc2dd","text":"<p>\ucd08\uae30 \uc18d\ub3c4\ub97c \uc218\ud3c9 \uc131\ubd84 \\(v_0\\cos\\theta\\)\uc640 \uc218\uc9c1 \uc131\ubd84 \\(v_0\\sin\\theta\\)\ub85c \ub098\ub215\ub2c8\ub2e4. \uc218\ud3c9 \uac00\uc18d\ub3c4\ub294 0\uc774\uace0 \uc218\uc9c1 \uac00\uc18d\ub3c4\ub294 \\(-g\\)\uc774\ubbc0\ub85c, \uac01 \uc131\ubd84\uc744 \uc2dc\uac04\uc5d0 \ub530\ub77c \uc801\ubd84\ud558\uba74 \uc704\uce58\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.</p> \\[ x(t) = v_0\\cos\\theta\\,t \\] \\[ y(t) = v_0\\sin\\theta\\,t - \\frac{1}{2}gt^2 \\] <p>\ubb3c\uccb4\uac00 \ucd9c\ubc1c \ub192\uc774\ub85c \ub3cc\uc544\uc62c \ub54c \\(y(t)=0\\)\uc785\ub2c8\ub2e4. \\(t=0\\)\uc744 \uc81c\uc678\ud55c \ube44\ud589 \uc2dc\uac04\uacfc \uc218\ud3c9 \ub3c4\ub2ec \uac70\ub9ac\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.</p> \\[ T = \\frac{2v_0\\sin\\theta}{g}, \\qquad R = v_0\\cos\\theta\\,T = \\frac{v_0^2\\sin(2\\theta)}{g} \\] <p>\uc218\uc9c1 \uc18d\ub3c4\uac00 0\uc774 \ub418\ub294 \uc2dc\uc810 \\(t=v_0\\sin\\theta/g\\)\uc758 \ucd5c\uace0 \ub192\uc774\ub294 \ub2e4\uc74c\uacfc \uac19\uc2b5\ub2c8\ub2e4.</p> \\[ H = \\frac{v_0^2\\sin^2\\theta}{2g} \\]"},{"location":"mechanics/projectile-motion/#_4","title":"\uc2dc\ubbac\ub808\uc774\uc158","text":"<p>\ucd08\uae30 \uc18d\ub825\uacfc \uac01\ub3c4\ub97c \ubc14\uafd4 \uada4\uc801, \ube44\ud589 \uc2dc\uac04, \ucd5c\uace0 \ub192\uc774, \uc218\ud3c9 \ub3c4\ub2ec \uac70\ub9ac\ub97c \ube44\uad50\ud574 \ubcf4\uc138\uc694.</p> <p>\uc2dc\ubbac\ub808\uc774\ud130 \uc0c8 \ucc3d\uc5d0\uc11c \uc5f4\uae30 \u00b7 Python \uc6d0\ubcf8 \ucf54\ub4dc</p>"},{"location":"mechanics/projectile-motion/#_5","title":"\ud655\uc778\ud560 \uc810","text":"<ol> <li>\uac19\uc740 \uc18d\ub825\uc5d0\uc11c \uac01\ub3c4\uac00 \ucee4\uc9c0\uba74 \ucd5c\uace0 \ub192\uc774\ub294 \uc5b4\ub5bb\uac8c \ub2ec\ub77c\uc9c0\ub098\uc694?</li> <li>\uac01\ub3c4\uac00 45\u00b0\uc77c \ub54c \uc218\ud3c9 \ub3c4\ub2ec \uac70\ub9ac\uac00 \ucd5c\ub300\uac00 \ub418\ub294 \uc774\uc720\ub294 \ubb34\uc5c7\uc778\uac00\uc694?</li> <li>\ucd08\uae30 \uc18d\ub825\uc744 \ub450 \ubc30\ub85c \ud558\uba74 \ube44\ud589 \uc2dc\uac04, \ucd5c\uace0 \ub192\uc774, \uc218\ud3c9 \ub3c4\ub2ec \uac70\ub9ac\ub294 \uac01\uac01 \uba87 \ubc30\uac00 \ub418\ub098\uc694?</li> </ol> <p>\uc774 \uacb0\uacfc\ub294 \uacf5\uae30 \uc800\ud56d\uc774 \uc5c6\ub294 \uc774\uc0c1\uc801\uc778 \ubaa8\ub378\uc5d0\uc11c\ub9cc \uc131\ub9bd\ud569\ub2c8\ub2e4. \uc2e4\uc81c \ubb3c\uccb4\ub294 \uacf5\uae30 \uc800\ud56d\uacfc \ubc14\ub78c \ub4f1\uc758 \uc601\ud5a5\uc744 \ubc1b\uc2b5\ub2c8\ub2e4.</p>"}]}